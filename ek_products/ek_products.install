<?php
use Drupal\Core\Database\Database;
/**
 * @file
 * Install, update and uninstall functions for the ek_products module.
 */

/**
 * Implements hook_uninstall().
 */
function ek_products_uninstall() {
    
    $configs = [
        'tour.tour.items',
        'tour.tour.items_list',
        'tour.tour.items_new',
        'tour.tour.items_parameters',
    ];
    
    foreach ($configs as $config) {
        // Deleting config.
        \Drupal::configFactory()->getEditable($config)->delete();
    }  
    
  // Clear ek_products data out of the cache.
  \Drupal::cache('data')->deleteAll();
}


/**
 * Implements hook_schema().
 * schema installation is not done at install time but wihin the application
 * in a separate database
 */

/**
 * Add format in items table for extended description.
 */
function ek_products_update_8001() {
    
        $schema = Database::getConnection('external_db','external_db')->schema();
        if(!$schema->fieldExists('ek_items', 'format')) {
            $spec = array(
                'description' => 'format of extended description',
                'type' => 'varchar',
                'length' => 20,
                'not null' => FALSE,     
            );
            $schema->addField('ek_items', 'format', $spec);
        }
        
        return t('Items table updated.');
}

/**
 * Changed routing format for autocomplete action.
 */
function ek_products_update_8002() {
    \Drupal::service('router.builder')->rebuild(); 
}

/**
 * Add settings table.
 * 
*/
function ek_products_update_8003() {
    
    $schema = Database::getConnection('external_db','external_db')->schema();
        if (!$schema->tableExists('ek_item_settings')) {
            
                $table =  [
                    'description' => 'Stores items settings.',
                    'fields' => [
                      'id' => [
                        'description' => 'Primary Key: Unique ID.',
                        'type' => 'int',
                        'unsigned' => TRUE,
                        'not null' => TRUE,
                      ],
                      'settings' => [
                        'description' => 'A serialized array containing the settings.',
                        'type' => 'blob',
                        'not null' => FALSE,
                        'size' => 'big',
                      ],
                    ],
                    'primary key' => ['id'],
                    
                  ];
            
            $schema->createTable('ek_item_settings', $table);
            
            Database::getConnection('external_db', 'external_db')
                ->insert('ek_item_settings')
                ->fields(array(
                  'id' => 0,
                  'settings' => '',
                ))
                ->execute(); 
            
            \Drupal::service('router.builder')->rebuild();
            return t('Items settings table created.');
        }

}


/**
 * Changed routing format for autocomplete action.
 */
function ek_products_update_8004() {
    \Drupal::service('router.builder')->rebuild(); 
}

/**
 * Add modal route
 */
function ek_products_update_8005() {
    \Drupal::service('router.builder')->rebuild(); 
}

/**
 * Add relationship table and fields.
 * 
*/
function ek_products_update_8008() {
    
    $schema = Database::getConnection('external_db','external_db')->schema();
        if (!$schema->tableExists('ek_item_relations')) {
            
                $table =  [
                    'description' => 'Stores items relationships.',
                    'fields' => [
                      'id' => [
                        'description' => 'Primary Key: Unique ID.',
                        'type' => 'serial',
                        'unsigned' => TRUE,
                        'not null' => TRUE,
                      ],
                      'parent_itemcode' => [
                        'description' => 'Main item code',
                        'type' => 'varchar',
                        'length' => 200,
                        'not null' => TRUE,
                        'default' => '',
                      ],
                      'child_itemcode' => [
                        'description' => 'Linked item code',
                        'type' => 'varchar',
                        'length' => 200,
                        'not null' => TRUE,
                        'default' => '',
                      ],
                      'relation_type' => [
                        'description' => 'e.g., accessory, alternative, required',
                        'type' => 'varchar',
                        'length' => 50,
                        'not null' => TRUE,
                        'default' => '',
                      ],
                    ],
                    'primary key' => ['id'],
                    'unique keys' => [
                        'relation_unique' => ['parent_itemcode', 'child_itemcode'],
                    ],
                    'indexes' => [
                        'parent_idx' => ['parent_itemcode'],
                        'child_idx' => ['child_itemcode'],
                    ],
                    
                  ];
            
            $schema->createTable('ek_item_relations', $table);
        }
        
        if(!$schema->fieldExists('ek_items', 'specs')) {
            $spec = array(
                'description' => 'Technical specifications extended',
                'type' => 'text',
                'not null' => FALSE,     
            );
            $schema->addField('ek_items', 'specs', $spec);
        }

        if(!$schema->fieldExists('ek_items', 'source_url')) {
            $source_url = array(
                'description' => 'Supplier catalogue URL for reference.',
                'type' => 'varchar',
                'length' => 255,
                'not null' => FALSE,     
            );
            $schema->addField('ek_items', 'source_url', $source_url);
        }
            
            \Drupal::service('router.builder')->rebuild();
            return t('Items table created.');
       

}
