<section class="product_card">
    <div class="product-actions">
        {{ items.list|raw }} 
        {{ items.search|raw }}
        {{ items.pdf|raw }}
    </div>

    <div class="products_card-data">
        <div class="product-header">
            <div class="edit-info">( {{ 'Last edit'|t }}: {{ items.stamp }})</div>
            <div class="company-name">{{ items.company }}</div>
        </div>

        <div class="product-identifiers">
            <div class="identifier-grid">
                <div class="identifier-item">
                    <span class="badge">{{ 'Item code'|t }}</span>
                    <div class="identifier-value">{{ items.itemcode }}</div>
                </div>
                <div class="identifier-item">
                    <span class="badge">{{ 'Item type'|t }}</span>
                    <div class="identifier-value">{{ items.type }}</div>
                </div>
                <div class="identifier-item">
                    <span class="badge">{{ 'Supplier'|t }}</span>
                    <div class="identifier-value">{{ items.supplier }}</div>
                </div>
                <div class="identifier-item">
                    <span class="badge">{{ 'Supplier code'|t }}</span>
                    <div class="identifier-value">{{ items.supplier_code }}</div>
                </div>
            </div>
        </div>

        <div class="product-descriptions">
            <div class="description-section">
                <div class="section-title"><span class="badge">{{ 'Main description'|t }}</span></div>
                <div class="section-content">{{ items.description1 }}</div>
            </div>
            
            <div class="description-section">
                <div class="section-title"><span class="badge">{{ 'Detailed description'|t }}</span></div>
                <div class="section-content">{{ items.description2|raw }}</div>
            </div>
            
            {% if items.specs %}
                <div class="description-section">
                    <div class="section-title"><span class="badge">{{ 'Supplier item specifications'|t }}</span></div>
                    <div class="section-content">
                        <ul class="specs-list">
                            {% for key, value in items.specs %}
                                <li><strong>{{ key }}:</strong> {{ value }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}
            
            {% if items.links %}
                <div class="description-section">
                    <div class="section-title"><span class="badge">{{ 'Linked items'|t }}</span></div>
                    <div class="section-content">
                        <ul class="links-list">
                            {% for link in items.links %}
                                {% for key, value in link %}
                                    <li>{{ key }}: <a href="/item/{{ value }}">{{ "view"|t }}</a></li>
                                {% endfor %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}
            
            {% if items.source_url %}
                <div class="description-section">
                    <div class="section-title"><span class="badge">{{ 'Catalog source'|t }}</span></div>
                    <div class="section-content">
                        <a target="_blank" href="{{ items.source_url }}">{{ 'Link'|t }}</a>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="product-tags">
            <div class="tag-row">
                <div class="tag-item">
                    <span class="badge">{{ 'Tag department'|t }}</span> {{ items.department }}
                </div>
                <div class="tag-item">
                    <span class="badge">{{ 'Tag size'|t }}</span> {{ items.size }}
                </div>
            </div>
            <div class="tag-row">
                <div class="tag-item">
                    <span class="badge">{{ 'Tag family'|t }}</span> {{ items.family }}
                </div>
                <div class="tag-item">
                    <span class="badge">{{ 'Tag color'|t }}</span> {{ items.color }}
                </div>
            </div>
            <div class="tag-row">
                <div class="tag-item full-width">
                    <span class="badge">{{ 'Tag collection'|t }}</span> {{ items.collection }}
                </div>
            </div>
        </div>

        <div class="expand-section">
            <div class="expand-toggle">
                <div id="expand" class="close-ico"></div>
            </div>
        </div>

        <div class="product-details">
            <div class="details-column primary">
                <div class="panel panel-default">
                    <div class="panel-heading toggle-heading" data-target="#l{{ items.id }}">
                        <h4 class="panel-title">{{ 'Logistic'|t }}</h4>
                    </div>
                    <div class="panel-body collapsible" id="l{{ items.id }}">
                        <table class="detail-table">
                            <tr>
                                <td>{{ 'Stock'|t }}</td>
                                <td>{{ items.units }} {{ items.unit_measure }}</td>
                            </tr>
                            <tr>
                                <td>{{ 'Size'|t }}</td>
                                <td>{{ items.item_size }}</td>
                            </tr>
                            <tr>
                                <td>{{ 'Packing size'|t }}</td>
                                <td>{{ items.pack_size }}</td>
                            </tr>
                            <tr>
                                <td>{{ 'Quantity per pack'|t }}</td>
                                <td>{{ items.qty_pack }}</td>
                            </tr>
                            <tr>
                                <td>{{ 'Quantity per 20 feet container'|t }}</td>
                                <td>{{ items.c20 }}</td>
                            </tr>
                            <tr>
                                <td>{{ 'Quantity per 40 feet container'|t }}</td>
                                <td>{{ items.c40 }}</td>
                            </tr>
                            <tr>
                                <td>{{ 'Minimum order'|t }}</td>
                                <td>{{ items.min_order }}</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading toggle-heading" data-target="#p{{ items.id }}">
                        <h4 class="panel-title">{{ 'Prices'|t }}</h4>
                    </div>
                    <div class="panel-body collapsible" id="p{{ items.id }}">
                        <table class="detail-table">
                            <tr>
                                <td>{{ 'Purchase'|t }}:</td>
                                <td>{{ items.purchase_price }} {{ items.currency }} ({{ items.date_purchase }})</td>
                            </tr>
                            <tr>
                                <td>{{ items.selling_price_label }}:</td>
                                <td>{{ items.selling_price }} {{ items.loc_currency }}</td>
                            </tr>
                            <tr>
                                <td>{{ items.promo_price_label }}:</td>
                                <td>{{ items.promo_price }} {{ items.loc_currency }}</td>
                            </tr>
                            <tr>
                                <td>{{ items.discount_price_label }}:</td>
                                <td>{{ items.discount_price }} {{ items.loc_currency }}</td>
                            </tr>
                            <tr>
                                <td>{{ items.exp_selling_price_label }}:</td>
                                <td>{{ items.exp_selling_price }} {{ items.exp_currency }}</td>
                            </tr>
                            <tr>
                                <td>{{ items.exp_promo_price_label }}:</td>
                                <td>{{ items.exp_promo_price }} {{ items.exp_currency }}</td>
                            </tr>
                            <tr>
                                <td>{{ items.exp_discount_price_label }}:</td>
                                <td>{{ items.exp_discount_price }} {{ items.exp_currency }}</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading toggle-heading" data-target="#b{{ items.id }}">
                        <h4 class="panel-title">{{ 'Barcodes'|t }}</h4>
                    </div>
                    <div class="panel-body collapsible" id="b{{ items.id }}">
                        {% for item in items.barcodes %}
                            <div class="barcode-item">
                                <div class="barcode-value">{{ item.barcode }}</div>
                                <div class="barcode-type">{{ item.encode }}</div>
                                {% if item.image %}
                                    <div class="barcode-image">{{ item.image|raw }}</div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="details-column secondary">
                <div class="products_card-images">
                    <div class="panel panel-default">
                        <div class="panel-heading toggle-heading" data-target="#i{{ items.id }}">
                        <h4 class="panel-title">{{ 'Images'|t }}</h4>
                        </div>
                        <div class="panel-body" id="i{{ items.id }}">
                            <div class="upload-section">
                                {{ items.upload_form|raw }}
                            </div>
                            <div class="images-grid">
                                {% for item in items.pictures %}
                                    <div class="image-item">
                                        {{ item.element|raw }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>