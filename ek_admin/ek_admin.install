/**
 * Add fields.
 */
function ek_admin_update_8009() {
  $schema = Database::getConnection('external_db', 'external_db')->schema();
  if (!$schema->fieldExists('ek_company', 'state')) {
    $spec = ['description' => 'address state', 'type' => 'varchar', 'length' => 50, 'not null' => FALSE];
    $schema->addField('ek_company', 'state', $spec);
  }
  if (!$schema->fieldExists('ek_company', 'state2')) {
    $spec = ['description' => 'address state', 'type' => 'varchar', 'length' => 50, 'not null' => FALSE];
    $schema->addField('ek_company', 'state2', $spec);
  }
}

/**
 * Add fields.
 */
function ek_admin_update_10001() {
  $schema = Database::getConnection('external_db', 'external_db')->schema();
  if (!$schema->fieldExists('ek_company_documents', 'folder')) {
    $spec = ['description' => 'document tag or folder', 'type' => 'varchar', 'length' => 200, 'not null' => FALSE];
    $schema->addField('ek_company_documents', 'folder', $spec);
    return t('Admin documents table field created.');
  }
  return t('Admin documents table field already exists.');
}

/**
 * Add route.
 */
function ek_admin_update_10002() {
  \Drupal::service('router.builder')->rebuild();
  return t('Admin routes rebuilt.');
}
