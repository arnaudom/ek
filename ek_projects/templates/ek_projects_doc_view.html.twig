{#
/**
 * @file
 * Default theme implementation for rendering document list in project page
 *
 *
 * Available items:
 *   id (db id)
 *   fid (bol) file status
 *   uri (string)
 *   extension (sting)
 *   icon_path (sting)
 *   icon (bol)
 *   delete (bol)
 *   email (bol)
 *   extranet (bol)
 *   doc_name (string)
 *   date
 *   size
 *   file_url
 *   delete_url
 *   mail_url
 *   extranet_url
 *   extranet_share (bol)
 *   access_url
 *   comment (string)
 *   sub_folder (string)
 *
 * @see ek_projects_doc_view
 *
 * @ingroup themeable
 */
#}

{% for folder, data in items %}
    
        <div class="doc-row sub-folder" id="{{ folder }}">
            <div class="doc-column sub-folder-title" onclick="jQuery('.{{ 'folder_' }}{{ key }}').toggle('fast');"><h1>{{ folder }}</h1></div>
        </div>
        
        
        {% for key, item in data %}

            {% if item.fid == 1 %}
                <div class="doc-row move" id="tr-{{ item.id }}">
                    <div class="doc-column" title='{{ item.doc_name }} |  {{ item.date }} , {{ item.size }}'>
                        <IMG src='../../{{ item.icon_path }}{{item.icon}}.png'/> 
                        <a href="{{ item.file_url }}" target='_blank' >{{ item.doc_name }}</a>
                    </div>
                    <div class="doc-column">{{ item.more|raw }} {{ item.comment }}</div>
                    {% if item.delete == 1 %}
                        <div class="doc-column" style="text-align: center;"><a id='d{{ item.key }}' href="{{ item.delete_url }}" class='use-ajax red' title={{'delete the file'|t }} >
                                <i class="fa fa-lg fa-trash-o" aria-hidden="true"></i></a></div>
                    {% else %}
                        <div class="doc-column" style="text-align: center;"><i class="fa fa-lg fa-trash" aria-hidden="true"></div>
                    {% endif %}

                    {% if item.access_url != '0' %}
                        <div class="doc-column" style="text-align: center;"><a href="{{ item.access_url }}" class='use-ajax red' title={{'manage access by users'|t }} >
                                <i class="fa fa-lg fa-lock" aria-hidden="true"></i></a></div>
                            {% else %}
                        <div class="doc-column" style="text-align: center;"><i class="fa fa-lg fa-lock" aria-hidden="true"></i></div>
                    {% endif %}

                    {% if item.email == 1 %}
                        <div class="doc-column" style="text-align: center;"><a href="{{ item.mail_url }}" class='use-ajax blue' title="{{'share by email'|t }}" >
                                <i class="fa fa-lg fa-envelope-o" aria-hidden="true"></i></a></div>
                            {% else %}
                        <div class="doc-column" style="text-align: center;"><i class="fa fa-lg fa-envelope-o" aria-hidden="true"></i></div>
                    {% endif %}

                    {% if item.extranet == 1 %}

                        {% if item.extranet_share == 1 %}

                            <div class="doc-column" style="text-align: center;"><a href="{{ item.extranet_url }}" class='use-ajax' title="{{'Extranet shared; click to unshare'|t }}">
                                    <span id="{{ item.elementId }}" class="extranet-btn-green" aria-hidden="true"></span></a></div>
                                {% else %}
                            <div class="doc-column" style="text-align: center;"><a href="{{ item.extranet_url }}" class='use-ajax' title="{{'Extranet not shared; click to share'|t }}">
                                    <span id="{{ item.elementId }}" class="extranet-btn-red" aria-hidden="true"></span></a></div>
                                {% endif %}

                    {% else %}
                        <div class="doc-column"></div>
                    {% endif %}
                </div>
            {% else %}
                <div class="doc-row hide">
                    <div class="doc-column">
                        <IMG src='../../{{ item.icon_path }}{{item.icon}}.png'/> 
                        {{ item.doc_name }}
                    </div>
                    <div class="doc-column">{{ item.comment }}</div>
                    <div class="doc-column" style="text-align: center;"><i class="fa fa-lg fa-trash-o" aria-hidden="true"></i></div>
                    <div class="doc-column"></div>
                    <div class="doc-column"></div>
                    <div class="doc-column"></div>
                </div>
                {% endif %}
        {% endfor %}   
{% endfor %}

