<section class="address_book_card">
    <div class="card-header">
        {% if items.create_project %}
            <div class='button'><span class="ico pencil"></span>{{ items.create_project }}</div>
        {% endif %}   
        <div class='button'><span class="ico search"></span>{{ items.search }}</div>
        <div class="edit-info"><span class="ico pencil"></span>{{ 'last edit'|t }} {{ items.stamp }}</div>
    </div>

    <div class="address_book_card-data">
        <div class="company-header">
            <div class="company-info">
                <h1 id="name">{{ items.name }}</h1>
                <div class="company-subinfo">
                    <span class="shortname">{{ items.shortname }}</span>
                    <span class="badge {{ items.type }}">{{ items.type|upper }}</span><span>{{ items.clone }}</span>
                </div>
            </div>
            {% if items.logo_url != '' %}
                <div class="company-logo">
                    <img alt="{{ items.name }} logo" src="{{ items.logo_url }}"/>
                </div>
            {% endif %}
        </div>

        <div class="info-grid">
            <div class="info-column">
                <div class="info-block">
                    <h2><span class="ico map-marker"></span>
                        <span class="clipboard_add">{{ 'Address'|t }}</span><span class="copy copyAdd">copied to clipboard</span>
                    </h2>
                    <div class="address-data">
                        <div class="address-line" id="address1">{{ items.address }}</div>
                        <div class="address-line" id="address2">{{ items.address2 }}</div>
                        <div class="address-line">
                            <span id="postcode">{{ items.postcode }}</span>
                            <span id="city">{{ items.city }}</span>
                        </div>
                        <div class="address-line">
                            <span id="state">{{ items.state }}</span>, 
                            <span id="country">{{ items.country }}</span>
                        </div>
                    </div>
                </div>

                <div class="info-block">
                    <h2><span class="ico phone"></span>{{ 'Contact'|t }}</h2>
                    <div class="contact-data">
                        {% if items.telephone %}
                            <div class="contact-line">
                                <span class="contact-label">{{ 'Tel'|t }}:</span>
                                <span class="contact-value">{{ items.telephone }}</span>
                            </div>
                        {% endif %}

                        {% if items.fax %}
                            <div class="contact-line">
                                <span class="contact-label">{{ 'Fax'|t }}:</span>
                                <span class="contact-value">{{ items.fax }}</span>
                            </div>
                        {% endif %}

                        {% if items.website != '' %}
                            <div class="contact-line">
                                <span class="contact-label">{{ 'Website'|t }}:</span>
                                <a href="http://{{ items.website }}" target="_blank" class="website-link">{{ items.website }}</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="info-column">
                <div class="info-block">
                    <div class="details-grid">
                        <div class="detail-item">
                            <span class='ab-badge'>{{ 'Reg. number'|t }}</span>
                            <span id="regnumber" class="detail-value">{{ items.reg }}</span>
                        </div>
                        
                        <div class="detail-item">
                            <span class='ab-badge'>{{ 'Status'|t }}</span>
                            <span id="astatus" class="status-badge status-{{ items.status|lower }}">{{ items.status }}</span>
                        </div>
                        <div class="detail-item">
                            <span class='ab-badge'>{{ 'Office'|t }}</span>
                            <span id="acategory" class="detail-value">{{ items.category }}</span>
                        </div>
                        
                        <div class="detail-item">
                            <span class='ab-badge'>{{ 'Tags'|t }}</span>
                            <div id="atags" class="tags-list">
                                {% set tags = items.activity|split(',') %}
                                {% for tag in tags %}
                                    {% set url = "/address_book?q=" ~ tag %}
                                    <a class="tagsearch" href='{{ url }}'><span class="tag-item">{{ tag|trim }}</span></a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr>

    <div class="address_book_card-contacts">
        <div class="section-header">
            <h2><span class="ico users"></span> {{ 'Name cards'|t }}</h2>
            <div class='add-contact'><span class='button'><span class="ico plus"></span>{{ items.add }}</span></div>
        </div>

        <div class="contact-cards">
            {% for item in items.contacts %}
                <div class="ab-panel">
                    <div class="ab-panel-heading">
                        <a href='#{{ item.id }}' onclick="jQuery('#{{ item.id }}').toggle();">
                            <h3 class="ab-panel-title">
                                <span id="salutation{{ item.id }}">{{ item.salutation }}</span> 
                                <span id="card{{ item.id }}">{{ item.contact_name }}</span>
                            </h3>
                        </a>
                    </div>
                    <div class="ab-panel-body" id="{{ item.id }}">
                        <div class="contact-card-content">
                            <div class="contact-details">
                                <div class="contact-row">
                                    <span class="ico user"></span>
                                    <span id="{{ item.id }}" class="clipboard_name">{{ item.contact_name }}
                                        
                                    </span><span id="copy{{ item.id }}" class="copy">copied to clipboard</span>
                                </div>
                                
                                {% if item.title %}
                                <div class="contact-row">
                                    <span class="ico briefcase"></span>{{ item.title }}
                                </div>
                                {% endif %}
                                
                                {% if item.department %}
                                <div class="contact-row">
                                    <span class="ico lab"></span>{{ item.department }}
                                </div>
                                {% endif %}
                                
                                {% if item.telephone %}
                                <div class="contact-row">
                                    <span class="ico phone"></span>{{ item.telephone }}
                                </div>
                                {% endif %}
                                
                                {% if item.mobilephone %}
                                <div class="contact-row">
                                    <span class="ico mobile"></span>{{ item.mobilephone }}
                                </div>
                                {% endif %}
                                
                                {% if item.email %}
                                <div class="contact-row">
                                    <span class="ico envelope"></span>{{ item.email }}
                                </div>
                                {% endif %}
                                
                                {% if item.link %}
                                <div class="contact-row">
                                    <span class="ico link"></span>{{ item.link }}
                                </div>
                                {% endif %}
                                
                                {% if item.comment %}
                                <div class="contact-row comment-row">
                                    <span class="ico comment"></span>{{ item.comment }}
                                </div>
                                {% endif %}
                            </div>
                            
                            <div class="contact-card-image">
                                {% if item.card_ != '' %}
                                    <a href='modal/nojs/{{ item.id }}' class='use-ajax'>
                                        <img src="{{ item.card }}" alt="{{ item.contact_name }} card">
                                    </a>
                                {% else %}
                                    <span class="ico namecard"></span>
                                {% endif %}
                                
                                {% if item.pdf|raw %}
                                <div class="pdf-download">
                                    <span class="ico file-pdf"></span>{{ item.pdf|raw }}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>