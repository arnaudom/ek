<?php

/**
 * @file
 * ek_address_book module .
 */

/**
 * Implementation hook ek_home.
 */
function ek_address_book_ek_home() {
    $build = [];
    $build[] = [
        'name' => 'address_book',
        'module' => 'Address book',
        'stamp' => 1586604000,
        'type' => 'new',
        'content' => '<a href="/address_book">Address book</a>: new fields available for State and company registration number.',
        'footer' => 'April 2020',
    ];

    return $build;
}

/**
 * Implementation hook download.
 */
function ek_address_book_file_download($uri) {

  if (strpos($uri ?? "",'address_book/cards/')) {
      // Check that the file exists and is an image.
      $image = \Drupal::service('image.factory')->get($uri);
      if ($image->isValid()) {
      
          return array(
            // Send headers describing the image's size, and MIME-type.
            'Content-Type' => $image->getMimeType(),
            'Content-Length' => $image->getFileSize(),
            // By not explicitly setting them here, this uses normal Drupal
            // Expires, Cache-Control and ETag headers to prevent proxy or
            // browser caching of private images.
          );
        
      }
  }
}

/**
 * Implementation hook_theme().
 */
function ek_address_book_theme() {
  return [
    'ek_address_book_card' => [
      'template' => 'ek_address_book_card',
      'variables' => ['items' => []],
    ], 
    'ek_address_book_form' => [
      'template' => 'ek_address_book_form',
      'variables' => ['items' => []],
    ],
    'ek_address_book_dashboard' => [
      'template' => 'ek_address_book_dashboard',
      'variables' => ['items' => []],
    ], 
    'ek_address_book_search_form' => [
      'template' => 'ek_address_book_search_form',
      'variables' => ['items' => []],
    ], 
    'ek_address_book_card_form' => [
      'template' => 'ek_address_book_form',
      'variables' => ['items' => []],
    ],    
    'ek_address_book_tip' => [
      'template' => 'ek_address_book_tip',
      'variables' => ['items' => []],
    ],          
    'edit_contact_form' => [
      'render element' => 'form'
    ],
  ];     
}


function template_preprocess_ek_address_book_card(&$variables) {                                 
  
}

function template_preprocess_ek_address_book_form(&$variables) {

  $form = $variables['items'];
  
  // Add wrapper class to the form
  if (!isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = [];
  }
  $variables['attributes']['class'][] = 'edit-address-book-form';
  
  // Create table sections with custom classes
  
  $row0 = [
    [
      'data' => [
        ['data' => $form['warnings'], 'class' => ['']],
      ],
      'class' => [''],
    ]
  ];

  $row1 = [
    [
      'data' => [
        ['data' => $form['name'], 'class' => ['name-field']],
        ['data' => $form['shortname'], 'class' => ['shortname-field']],
        ['data' => $form['reg'], 'class' => ['reg-field']],
        ['data' => $form['status'], 'class' => ['status-field']],
      ],
      'class' => ['basic-info-row', 'info-row-1'],
    ]
  ];
  
  $row1[] = [
    'data' => [
      
    ],
    'class' => ['basic-info-row', 'info-row-2'],
  ];
  
  $row1[] = [
    'data' => [
      ['data' => ['#markup' => "<div id='alert'></div>"], 'colspan' => 3, 'class' => ['alert-container']],
    ],
    'class' => ['alert-row'],
  ];
  
  $row2 = [
    [
      'data' => [
        ['data' => $form['address'], 'class' => ['address-field']],
        ['data' => $form['city'], 'class' => ['city-field']],
        ['data' => $form['postcode'], 'class' => ['postcode-field']],
      ],
      'class' => ['address-row', 'address-row-1'],
    ]
  ];
  
  $row2[] = [
    'data' => [
      ['data' => $form['address2'], 'class' => ['address2-field']],
      ['data' => $form['state'], 'class' => ['state-field']],
      ['data' => $form['country'], 'class' => ['country-field']],
    ],
    'class' => ['address-row', 'address-row-2'],
  ];
  
  $row3 = [
    [
      'data' => [
        ['data' => $form['telephone'], 'class' => ['telephone-field']],
        ['data' => $form['fax'], 'class' => ['fax-field']],
        ['data' => $form['website'], 'class' => ['website-field']],
      ],
      'class' => ['contact-row'],
    ]
  ];
  
  $row4 = [
    [
      'data' => [
        ['data' => $form['type'], 'class' => ['type-field']],
        ['data' => $form['category'], 'class' => ['category-field']],
        ['data' => $form['tags'], 'class' => ['tags-field']],
      ],
      'class' => ['classification-row'],
    ]
  ];
  
  $row5 = [
    [
      'data' => [
        ['data' => $form['logo'], 'class' => ['logo-field']],
        ['data' => $form['currentlogo'], 'class' => ['currentlogo-field']],
        ['data' => $form['delete_logo'], 'class' => ['delete-logo-field']],
      ],
      'class' => ['logo-row'],
    ]
  ];
  
  // Unset the original form elements as they've been added to the tables
  unset(
    $form['warnings'], $form['name'], $form['shortname'], $form['status'], $form['address'],
    $form['address2'], $form['state'], $form['city'], $form['postcode'], 
    $form['country'], $form['reg'], $form['telephone'], $form['fax'],
    $form['website'], $form['type'], $form['category'], $form['tags'],
    $form['currentlogo'], $form['delete_logo'], $form['logo']
  );
  
  // Prepare the tables with section headers
  $variables['form'] = $form;
  
  $variables['form'][] = [
    '#theme' => 'table',
    '#header' => '',
    '#rows' => $row0,
    '#attributes' => ['class' => ['']],
    '#weight' => -11,
  ];
  // Basic Info Table
  $variables['form'][] = [
    '#type' => 'markup',
    '#markup' => '<h3 class="section-header">'. t('Name') .'</h3>',
    '#weight' => -10,
  ];
  
  $variables['form'][] = [
    '#theme' => 'table',
    '#header' => '',
    '#rows' => $row1,
    '#attributes' => ['class' => ['ab-form-section', 'basic-info-section']],
    '#weight' => -9,
  ];
  
  // Address Table
  $variables['form'][] = [
    '#type' => 'markup',
    '#markup' => '<h3 class="section-header">'. t('Address') .'</h3>',
    '#weight' => -8,
  ];
  
  $variables['form'][] = [
    '#theme' => 'table',
    '#header' => '',
    '#rows' => $row2,
    '#attributes' => ['class' => ['ab-form-section', 'address-section']],
    '#weight' => -7,
  ];
  
  // Contact Table
  $variables['form'][] = [
    '#type' => 'markup',
    '#markup' => '<h3 class="section-header">'. t('General contact') .'</h3>',
    '#weight' => -6,
  ];
  
  $variables['form'][] = [
    '#theme' => 'table',
    '#header' => '',
    '#rows' => $row3,
    '#attributes' => ['class' => ['ab-form-section', 'contact-section']],
    '#weight' => -5,
  ];
  
  // Classification Table
  $variables['form'][] = [
    '#type' => 'markup',
    '#markup' => '<h3 class="section-header">'. t('Classification') .'</h3>',
    '#weight' => -4,
  ];
  
  $variables['form'][] = [
    '#theme' => 'table',
    '#header' => '',
    '#rows' => $row4,
    '#attributes' => ['class' => ['ab-form-section', 'classification-section']],
    '#weight' => -3,
  ];
  
  // Logo Table
  $variables['form'][] = [
    '#type' => 'markup',
    '#markup' => '<h3 class="section-header">'. t('Logo') .'</h3>',
    '#weight' => -2,
  ];
  
  $variables['form'][] = [
    '#theme' => 'table',
    '#header' => '',
    '#rows' => $row5,
    '#attributes' => ['class' => ['ab-form-section', 'logo-section']],
    '#weight' => -1,
  ];


}

function template_preprocess_ek_address_book_card_form(&$variables) {

  $form = $variables['items'];
  $variables['form'] = $form;

}

