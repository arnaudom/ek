<?php

/**
 * @file
 * ek_messaging.module
 *
 * Changes from original:
 *  - ek_message_register() is now a thin backward-compatibility wrapper that
 *    delegates to the ek_messaging.message_registration service.  Existing
 *    callers in other modules continue to work without modification.
 *  - hook_theme(), hook_mail(), etc. are unchanged.
 */

use Drupal\Core\Database\Database;


// =============================================================================
// Theme
// =============================================================================

/**
 * Implements hook_theme().
 */
function ek_messaging_theme() {
    return [
        'ek_messaging_read' => [
            'template'  => 'ek_messaging_read',
            'variables' => ['items' => []],
        ],
        'ek_messaging_mail' => [
            'template'  => 'ek_messaging_mail',
            'variables' => ['items' => []],
        ],
    ];
}


// =============================================================================
// Message registration (BC wrapper)
// =============================================================================

/**
 * Register a message.
 *
 * @deprecated
 *   Use \Drupal::service('ek_messaging.message_registration')->register($data)
 *   directly.  This procedural function is kept only for backward compatibility
 *   with third-party modules that call it.
 *
 * @param array $data
 *   Same keys as before – see MessageRegistrationService::register() for docs.
 *   The 'body' value may be passed pre-serialized (legacy) or as a plain
 *   string; the service handles both forms.
 *
 * @return int
 *   The new message ID.
 */
function ek_message_register(array $data): int {
    return \Drupal::service('ek_messaging.message_registration')->register($data);
}


// =============================================================================
// Hooks
// =============================================================================

/**
 * Implements hook_ek_home().
 */
function ek_messaging_ek_home() {
    return [
        [
            'name'    => 'feature_broadcast',
            'module'  => 'Messaging',
            'stamp'   => 1597560000,
            'type'    => 'new',
            'content' => 'Send <a href="/messaging/send/broadcast">broadcast</a> messages to all users.',
            'footer'  => 'August 2020',
        ],
    ];
}

/**
 * Implements hook_file_download().
 */
function ek_messaging_file_download($uri) {
    if (strpos($uri ?? '', '/inline-images/')) {
        return ['Content-Type' => \Drupal::service('file.mime_type.guesser')->guessMimeType($uri)];
    }
}

/**
 * Implements hook_mail().
 */
function ek_messaging_mail($key, &$message, $params) {
    global $base_url;
    // fix warning trying to access array on null / deprecated in drupal 11
    // $logo = \Drupal::config('system.theme')->get('logo');
    // $site_logo = \Drupal::request()->getSchemeAndHttpHost() . $logo['url'];
    $params['options']['logo']      = \Drupal::request()->getSchemeAndHttpHost() . theme_get_setting('logo.url');
    $params['options']['site']      = \Drupal::config('system.site')->get('name');
    $theme              = \Drupal::theme()->getActiveTheme()->getName();
    $color_config       = \Drupal::config("color.theme.{$theme}");
    $color_settings     = $color_config->getRawData();
    $params['options']['site_color'] = $color_settings['palette']['top'];
    $params['options']['origin']    = \Drupal::currentUser()->getAccountName();
    $params['options']['stamp']     = date('F j, Y, g:i a');
    $priority = ['3' => t('low'), '2' => t('normal'), '1' => t('high')];
    $color    = ['3' => '#159F45', '2' => '#0D67A7', '1' => '#A70D0D'];
    $params['options']['priority'] = $priority[$params['priority']];
    $params['options']['color']    = $color[$params['priority']];
    $params['options']['link']     = $params['link'];
    $params['options']['url']      = $params['url'];

    switch ($key) {
        case 'ek_message':
            if ($params['link'] == 0) {
                if (preg_match('/src="([^"]+)"/', $params['body'], $body)) {
                    $params['body'] = str_replace('src="/', 'src="' . $base_url, $params['body']);
                }
            }
            $render = ['#markup' => $params['body']];
            $message['From']    = $params['from'];
            $message['subject'] = $params['subject'];
            $message['body'][]  = \Drupal::service('renderer')->render($render);
            $message['options'] = $params['options'];
            $message['headers']['Disposition-Notification-To'] = $params['from'];
            $message['headers']['X-Confirm-Reading-To']        = $params['from'];
            if ($params['priority'] == 1) {
                $message['headers']['Priority']         = 'High';
                $message['headers']['X-Priority']       = '1';
                $message['headers']['X-MSMail-Priority'] = 'Highest';
            } else {
                $message['headers']['Priority']         = 'normal';
                $message['headers']['X-Priority']       = '3';
                $message['headers']['X-MSMail-Priority'] = 'Normal';
            }
            break;
    }
}

/**
 * Implements hook_mailer_PLUGIN_ID_init() via symfony_mailer.
 */
function ek_messaging_mailer_ek_messaging_init(\Drupal\symfony_mailer\EmailInterface $email) {}

function ek_messaging_mailer_ek_messaging_build(\Drupal\symfony_mailer\EmailInterface $email) {}

function ek_messaging_mailer_ek_messaging_post_send(\Drupal\symfony_mailer\EmailInterface $email) {}
