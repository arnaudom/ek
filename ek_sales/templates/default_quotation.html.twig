{#
 * Default quotation template in twig for html display
 #}

<div class='button' ><i class='fa fa-edit'></i><a href='{{ content.url_edit }}'>{{ 'Edit'|t }}</a></div>
<div class='button'><i class='fa fa-file-pdf-o'></i><a href='{{ content.url_pdf }}'> {{ 'Pdf'|t }}</a></div>

<page_wrapper>
    <page>
        <page_header>
            <table>
                <tr>
                    <td class="c70 left">
                        {% if content.company.logo != '' %}
                            {% set path = content.company.logo %}
                            {% if file_exists(path) %}
                                <IMG src='{{ file_url(path) }}'/>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td class="c30 left">
                        <b><h2>{{ content.company.name }}</h2></b>
                        {% if content.company.reg_number %}
                            <br/><small>({{ content.company.reg_number }})</small>
                        {% endif %}
                        <br/>{{ content.company.address1 }}
                        <br/>{{ content.company.address2 }}
                        {% if content.company.postcode %}
                            <br/>{{ content.company.postcode }}, 
                        {% else %}
                            <br/>
                        {% endif %}
                        {% if content.company.country %}
                            {{ content.company.country }}
                        {% endif %}
                        {% if content.company.telephone %}
                            <br/>{{ 'Tel'|t }}:{{ content.company.telephone }}, 
                        {% else %}
                            <br/>
                        {% endif %}
                        {% if content.company.fax %}
                            {{ 'Fax'|t }}:{{ content.company.fax }}
                        {% endif %}
                    </td>
                </tr>
            </table>
        </page_header>

        <page_reference>
            <table>
                <tr>
                    <td class="c70 left"></td>
                    <td class="c30 left">
                        <h2 class="blue">{{ 'Quotation'|t|upper }}</h2>
                        <br/>{{ content.items.reference }}
                        <br/>{{ "Date"|t }}: {{ content.head.date }}
                    </td>
                </tr>
            </table>
        </page_reference>

        <page_client>
            <table>
                <tr>
                    <td class="c10"></td>
                    <td class="c50 left">
                        <h2 class="">{{ content.client.name|upper }}</h2>
                        <br/>{{ content.client.address }}
                        {% if content.client.address2 %}
                            <br/>{{ content.client.address2 }}
                        {% endif %}
                        {% if content.client.city %}
                            <br/>{{ content.client.city }}
                        {% endif %}
                        {% if content.client.postcode %}
                            , {{ content.client.postcode }}, 
                        {% endif %}
                        {% if content.client.country %}
                            , {{ content.client.country }}
                        {% endif %}
                        {% if content.client.telephone %}
                            <br/>{{ 'Tel'|t }}:{{ content.client.telephone }}, 
                        {% else %}
                            <br/>
                        {% endif %}
                        {% if content.client.fax %}
                            {{ 'Fax'|t }}:{{ content.client.fax }}
                        {% endif %}
                        
                        {% if content.client_card.contact_name is defined %}
                            <br/><h3>{{ "Attention to"|t }}:{{ content.client_card.salutation }} {{ content.client_card.contact_name }}</h3>
                        {% endif %}
                    </td>
                    <td class="c40 center">{{ content.copy|raw }} {{ content.original|raw }}</td>
                </tr>
            </table>
        </page_client>

        <page_comments>
            <table>
                <tr>
                    <td class="c10 left"></td>
                    <td class="c90 left">{{ content.head.comment|nl2br }}</td>
                </tr>
                
                {% if content.head.pcode %}
                    <tr>
                        <td class='c10'></td>
                        <td class='c90 left'>{{ 'Our ref.'|t }} {{ content.project_link|raw }}</td>
                    </tr>
                {% endif %}
            </table>
        </page_comments>

        <page_items>
            <table>
                <tr>
                    <th class="c10 left"></th>
                    <th class="c10 center">{{ 'Description'|t }}</th>
                    <th class="c10"></th><th class="c10"></th><th class="c10"></th>
                    <th class="c10 center">{{ 'Unit price'|t }} {{ content.head.currency }}</th>
                    <th class="c10 center">{{ 'Quantity'|t }}</th>
                    <th class="c10 right">{{ 'Amount'|t }} {{ content.head.currency }}</th>
                </tr>
                
                {% set grandtotal = 0 %}
                {% set subtotal = 0 %}
                {% set taxtotal = 0 %}
                {% set i = 1 %}
                {% set j = 1 %}
                
                {% for detail in content.items %}
                    {% if detail is iterable and detail.item is not empty %}
                        {% set group = 0 %}
                        {% set st = 0 %}
                        <tr>
                            {% if detail.item == "sub_total" or detail.item == "[sub total]" %}
                            {#sub total row #}
                                <td></td>
                                <td colspan='4'></td>
                                <td></td>
                                <td class="right lightgrey_background"><b>{{ 'Sub total'|t }}</b></td>
                                 {% set st = 1 %}
                            {% elseif detail.total == 0 and detail.value == 0 %}
                            {#group row #}
                                <td class="center">{{ i }} -</td>
                                <td colspan='5' class="left"><b>{{ detail.item|nl2br }}</b></td>
                                {% set i = i + 1 %}
                                {% set j = 1 %}
                                {% set group  = 1 %}
                            {% else %}
                            {# item row #}
                                {% set l = (i > 1) ? (i - 1) : "1" %}
                                <td class="right">[{{ j }}]</td>
                                <td colspan='4' class="left">{{ detail.item|nl2br }}</td>
                                {% set j = j + 1 %}
                            {% endif %}
                            
                            {% if detail.value != 0 %}
                            {# item row price #}
                                <td class="right lline">{{ detail.value|number_format(2) }}</td>
                            {% else %}
                                {% if st == 0 and group != 1 %}
                                <td class="lline"></td>
                                {% endif %}
                            {% endif %}
                            
                            {% if detail.unit != 0 %}
                            {# item row qty #}
                                <td class="center lline">{{ detail.unit }}</td>
                            {% else %}
                                {% if st == 0  and group != 1 %}
                                <td class=" lline"></td>
                                {% endif %}
                            {% endif %}
                            
                            {% if detail.total != 0 %}
                                <td class="right lline rline">{{ detail.total|number_format(2) }}</td>
                            {% elseif detail.item == "sub_total" or detail.item == "[sub total]" %}
                                <td class="right cellbordertop lightgrey_background  lline rline">{{ subtotal|number_format(2) }}</td>
                                {% set subtotal = 0 %}
                            {% else %}
                                <td class=""></td>
                            {% endif %}
                            
                            {% set subtotal = (subtotal + detail.total)|round(2) %}
                            {% set grandtotal = (grandtotal + detail.total)|round(2) %}
                            {% if detail.opt == 1 %}
                                {% set taxtotal = (taxtotal + detail.total)|round(2) %}
                            {% endif %}

                        </tr>

                        {% if content.items.column_active2 and group == 0 and st == 0 %}
                            <tr>
                            {% if content.items.column_active3 and group == 0 %}
                            {# 2 columns actives #}
                            
                                <td class=""></td>
                                <td  class="left ">{{ content.items.column_name2 }}:</td>
                                <td  class="left">{{ detail.column_2 }}</td>
                                <td  class="left">{{ content.items.column_name3 }}:</td>
                                <td  class="left ">{{ detail.column_3 }}</td>
                            
                            {% else %}
                            {# 1 columns active #}
                                <td class=""></td>
                                <td  colspan=2 class="left ">{{ content.items.column_name2 }}:</td>
                                <td  colspan=2 class="left ">{{ detail.column_2 }}</td>
                            {% endif %}
                            </tr>

                        {% elseif content.items.column_active3 and group == 0 and st == 0  %}
                            {# 1 columns active #}
                            <tr>
                                <td class=""></td>
                                <td  colspan=2 class="left">{{ content.items.column_name3 }}:</td>
                                <td  colspan=2 class="left ">{{ detail.column_3 }}</td>
                            </tr>
                        {% endif %}
                    {% endif %}
                {% endfor %}
            
        </page_items>

        <page_total>
           
                <tr>
                    <td></td>
                    <td colspan='6' class="left"><b>{{ 'Total'|t }} {{ content.head.currency }}</b></td>
                    <td class=" cellbordertop right"><b>{{ grandtotal|number_format(2) }}</b></td>
                </tr>
                
                {% set freight = 0 %}
                {% if content.items.incoterm_name != "" and content.items.incoterm_name != "na" and content.items.incoterm_rate > 0 %}
                    {% set freight = (grandtotal * content.items.incoterm_rate / 100)|round(2) %}
                    <tr>
                        <td></td>
                        <td colspan='6' class="left"><b>{{ content.items.incoterm_name }} {{ content.items.incoterm_rate }}%</b></td>
                        <td class="c10 right"><b>{{ freight|number_format(2) }}</b></td>
                    </tr>
                {% endif %}
                
                {% set tax = 0 %}
                {% if content.items.tax_name != "" %}
                    {# TODO include freight in tax?#}
                    {% set tax = ((taxtotal) * content.items.tax_rate / 100)|round(2) %}
                    <tr>
                        <td></td>
                        <td colspan='6' class="left"><b>{{ content.items.tax_name }} {{ content.items.tax_rate }}%</b></td>
                        <td class="right"><b>{{ tax|number_format(2) }}</b></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td colspan='6' class="left"><b>{{ 'Total with tax'|t }} {{ content.head.currency }}</b></td>
                        <td class="right cellbordertop"><b>{{ (tax + grandtotal + freight)|number_format(2) }}</b></td>
                    </tr>
                {% else %}
                    <tr>
                        <td></td>
                        <td colspan='6' class="left"><b>{{ 'Grand total'|t }} {{ content.head.currency }}</b></td>
                        <td class="right cellbordertop"><b>{{ (grandtotal + freight)|number_format(2) }}</b></td>
                    </tr>
                {% endif %}
            
            
            {% set total_in_words = number_to_word(tax + grandtotal + freight) %}
                    <tr>
                        <td></td>
                        <td colspan='7' class="right"><b>{{ total_in_words }}</b></td>
                    </tr>
            </table>
        </page_total>

        <page_signature>
            <table>
                <tr>
                    <td class="c10 left"></td>
                    <td class="c60 left">
                        {% if content.signature == "1" and content.company.sign is defined %}
                            {% set path = content.company.sign %}
                            {% if file_exists(path) %}
                                <IMG src='{{ file_url(path) }}'/>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td>______________________________<td>
                    <td></td>
                </tr>
                <tr>
                    <td></td>
                    <td>{{ "Authorized signatory"|t }}<td>
                    <td></td>
                </tr>
            </table>
        </page_signature>
        
        <hr>
        
        {% if content.company.address3 != "" %}
            <page_correspondence>
                <table>
                    <tr>
                        <td class="c100 center">
                            <p class="grey">{{ 'Correspondence address'|t }}:
                            {{ content.company.address3 }} {{ content.company.address4 }} {{ content.company.postcode2 }}, {{ content.company.city2 }}, {{ content.company.country2 }}
                            <br/>{{ 'Tel'|t }}: {{ content.company.telephone2 }} {{ 'Fax'|t }}:{{ content.company.fax2 }}
                            </p>
                        </td>
                    </tr>
                </table>
            </page_correspondence>
        {% endif %}
    </page>
</page_wrapper>